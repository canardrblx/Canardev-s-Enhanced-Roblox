{
  "manifest_version": 3,
  "name": "Canardev's Enhanced Roblox",
  "version": "1.30.0",
  "description": "Makes Roblox look and feel better. Themes, redesigned pages, and more. Free, open source, no tracking.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://discord.com/api/webhooks/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "content/shared.js",
        "content/ui.js",
        "content/theme.js"
      ],
      "css": [
        "content/styles.css",
        "content/ui.css",
        "content/pages/home.css",
        "content/pages/discover.css",
        "content/pages/search.css",
        "content/pages/game.css",
        "content/pages/profile.css",
        "content/pages/friends.css",
        "content/pages/groups.css",
        "content/pages/catalog.css",
        "content/pages/messages.css",
        "content/pages/settings.css",
        "content/pages/transactions.css",
        "content/pages/groupconfig.css",
        "content/pages/badge.css",
        "content/pages/pass.css",
        "content/pages/inventory.css",
        "content/pages/favorites.css",
        "content/pages/trades.css",
        "content/pages/avatar.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "content/settings.js",
        "content/sidebar.js",
        "content/topbar.js",
        "content/customsidebar.js",
        "content/titles.js",
        "content/chat.js",
        "content/groups.js",
        "content/homeprofile.js",
        "content/sections.js",
        "content/continue.js",
        "content/presencerings.js",
        "content/communityrename.js",
        "content/updatecheck.js",
        "content/searchpage.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "content/pages/home.js",
        "content/pages/discover.js",
        "content/pages/search.js",
        "content/pages/game.js",
        "content/pages/profile.js",
        "content/pages/friends.js",
        "content/pages/groups.js",
        "content/pages/catalog.js",
        "content/pages/messages.js",
        "content/pages/settings.js",
        "content/pages/transactions.js",
        "content/pages/groupconfig.js",
        "content/pages/badge.js",
        "content/pages/pass.js",
        "content/pages/inventory.js",
        "content/pages/favorites.js",
        "content/pages/trades.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "js": [
        "content/gamepage.js",
        "content/serverbrowser.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/my/avatar*"
      ],
      "js": [
        "content/avatar.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/profile*"
      ],
      "js": [
        "content/profilesocial.js",
        "content/profileredesign.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/my/account*",
        "https://www.roblox.com/my/settings*",
        "https://www.roblox.com/communities/*/configure*",
        "https://www.roblox.com/communities/configure*",
        "https://www.roblox.com/groups/configure*"
      ],
      "js": [
        "content/settingsreskin.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/catalog*"
      ],
      "js": [
        "content/catalogpage.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cer@canardev.dev"
    }
  }
}
